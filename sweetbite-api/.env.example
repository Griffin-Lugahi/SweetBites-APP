# Server
PORT=4000
NODE_ENV=development

# Postgres connection string.
# Render/Railway/Supabase all give you this directly from their dashboard.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweetbite

# Set to "true" only if your provider requires SSL (Render/Railway/Supabase
# usually do in production; local Postgres usually doesn't).
DATABASE_SSL=false

# JWT
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API from a browser.
# Use your deployed frontend URL(s) in production.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# For the live site use the ORIGIN only (no path, no trailing slash), e.g.:
#   CORS_ORIGIN=https://griffin-lugahi.github.io

# How many reverse-proxy hops sit in front of the app. Leave unset: it
# defaults to 1 in production (Render/Railway) and off locally. Needed so
# rate limits see each visitor's real IP.
# TRUST_PROXY=1